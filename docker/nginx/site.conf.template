# Rendered by docker/entrypoint.sh (envsubst on the names listed there).
# Adapted from docs/deployment.md. TLS is terminated by Render, so this
# listens on plain HTTP on $PORT and never redirects by scheme.
server {
    listen ${PORT} default_server;
    listen [::]:${PORT} default_server;
    server_name _;

    root /var/www/html/public;
    index index.php;

    client_max_body_size 14M;               # matches post_max_size

${AUTH_DIRECTIVES}
${ROBOTS_SERVER}

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json application/xml image/svg+xml text/plain;

    # Versioned CSS/JS/icons (?v=... changes whenever the file does).
    location ~* \.(css|js|svg|ico|woff2)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
${ROBOTS_LOCATION}
        try_files $uri =404;
    }

    # Uploaded media. NEVER execute scripts here, whatever the extension:
    # this block has no fastcgi_pass, and the .php rule below only matches
    # in other locations because ^~ wins over regex locations.
    location ^~ /storage/ {
        add_header Cache-Control "public, max-age=2592000";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox" always;
${ROBOTS_LOCATION}
        try_files $uri =404;
    }

    # The site's own images (unversioned, so a shorter cache).
    location ^~ /asset/ {
        add_header Cache-Control "public, max-age=604800";
${ROBOTS_LOCATION}
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Only the front controller runs PHP.
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        # Passed through exactly as received from Render's router; the app
        # decides whether to trust it (TRUSTED_PROXIES).
        fastcgi_param HTTP_X_FORWARDED_PROTO $http_x_forwarded_proto;
        fastcgi_pass unix:/run/php/php-fpm.sock;
        fastcgi_read_timeout 60s;
${ROBOTS_PHP}
    }

    location ~ \.php$ {
        return 404;
    }

    location ~ /\.(?!well-known) { deny all; }
}
