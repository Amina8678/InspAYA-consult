# Production environment for InspAya Consult. Copy to .env on the server
# (never commit the real file) and fill in every REQUIRED value.
# Full walkthrough: docs/deployment.md. Last step before launch:
#   php artisan launch:check

# --- Application (REQUIRED) -------------------------------------------------
APP_NAME="InspAya Consult"
APP_ENV=production
APP_DEBUG=false
# Generate with: php artisan key:generate --force   (once; changing it later
# signs everyone out and breaks anything encrypted with the old key)
APP_KEY=
# The public HTTPS address, no trailing slash. Reset links, the sitemap and
# media URLs are built from it, and the CSP only allows images from this host.
APP_URL=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- HTTPS behind a reverse proxy / load balancer ---------------------------
# Address(es) of the proxy that terminates TLS, comma separated IPs or CIDRs,
# e.g. 10.0.0.5 or 10.0.0.0/24. Required when a proxy is in front; leave blank
# ONLY if this server terminates TLS itself. Wrong or blank behind a proxy
# causes a redirect loop. Never use "*" if the app is also reachable directly.
# Run `php artisan config:cache` after changing it.
TRUSTED_PROXIES=
# Strict-Transport-Security max-age in seconds. 1 week to start; raise (for
# example 31536000) once HTTPS has been stable for a while.
HSTS_MAX_AGE=604800

# --- Logging ----------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=warning
# Days of daily log files to keep.
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# --- Database (REQUIRED): MySQL 8, utf8mb4 ----------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Session, cache, queue --------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
CACHE_STORE=database
# "database" (or redis). Not "sync": that would send email during the visitor's
# request and fail the form when the mail server is slow. A queue worker must
# be running; see docs/deployment.md.
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail (REQUIRED): the client's SMTP provider -----------------------------
# MAIL_MAILER=log or array never delivers anything; launch:check fails on it.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# A real, verified sender on that provider. Left blank on purpose.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- First Super Admin (REQUIRED for the one-time seed only) ---------------
# Read by `php artisan db:seed --force`. Password: 12+ characters. After the
# first sign-in, change the password in the CMS, delete SUPER_ADMIN_PASSWORD
# from this file and run `php artisan config:cache` again.
SUPER_ADMIN_NAME=
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- Optional ---------------------------------------------------------------
# Days to keep failed-login audit rows (login_failed / login_throttled).
AUDIT_LOGIN_RETENTION_DAYS=90
