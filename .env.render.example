# Render (Docker) environment for InspAya Consult. Keys only: nothing here is
# a secret and the real values live in Render, never in git. Put the shared
# keys in the environment group (render.yaml: inspaya-shared) so the web and
# worker services cannot drift. Walkthrough: docs/render.md.

# --- Application -------------------------------------------------------------
APP_NAME="InspAya Consult"
APP_ENV=production
APP_DEBUG=false
# Secret. `php artisan key:generate --show`, set once, keep a copy.
APP_KEY=
# The public HTTPS address, no trailing slash.
APP_URL=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- HTTPS behind Render's router --------------------------------------------
# Render terminates TLS and the container is reachable only through its
# router, so "*" is safe here (docs/render.md "Why TRUSTED_PROXIES=*").
TRUSTED_PROXIES=*
HSTS_MAX_AGE=604800
SESSION_SECURE_COOKIE=true

# --- Logging: Render collects stderr ------------------------------------------
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Database: Neon PostgreSQL, direct (non-pooler) host ----------------------
DB_CONNECTION=pgsql
# ep-xxxx.eu-central-1.aws.neon.tech (NOT the -pooler host)
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
# Secret.
DB_PASSWORD=
# require is the minimum Neon accepts; verify-full also checks the server
# certificate (needs DB_SSLROOTCERT below).
DB_SSLMODE=require
# Only with verify-full: the image's CA bundle.
DB_SSLROOTCERT=

# --- Session, cache, queue stay on the database -------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail: Brevo SMTP ----------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
# Brevo SMTP login (not your account email password).
MAIL_USERNAME=
# Secret: a Brevo SMTP key.
MAIL_PASSWORD=
# A sender verified in Brevo.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- First Super Admin: read only by the one-time `db:seed --force` -----------
SUPER_ADMIN_NAME=
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_EMAIL=
# Secret. Delete it after the first sign-in.
SUPER_ADMIN_PASSWORD=

# --- Container behaviour (read by docker/, not by Laravel) --------------------
# Web service only, for a staging site: both blank/0 on production.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
STAGING_NOINDEX=0
# Seconds the queue worker sleeps when the queue is empty (worker service).
QUEUE_SLEEP=3
# Web service: php-fpm workers = max database connections it can hold.
PHP_FPM_MAX_CHILDREN=8
