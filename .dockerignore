# Keep secrets, VCS data and anything rebuilt inside the image out of the context.
.git
.github
.gitattributes
.gitignore
.DS_Store
.claude
.vite
.editorconfig
.phpunit.result.cache
.env
.env.*
!.env.render.example
vendor
node_modules
tests
phpunit.xml
docs
README.md
render.yaml
Dockerfile
.dockerignore
bootstrap/cache/*.php
public/storage
public/hot
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*
storage/app/public/*
storage/app/private/*
!**/.gitignore
